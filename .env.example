# 디스코드 개발자 포털 > Bot > Token
DISCORD_TOKEN=
# 디스코드 개발자 포털 > General Information > Application ID
DISCORD_CLIENT_ID=
# (선택) 개발용 테스트 서버 ID. 지정하면 이 서버에만 커맨드를 즉시 등록한다.
DISCORD_DEV_GUILD_ID=
# (선택) SQLite 파일 경로. 기본값: data/bot.sqlite
DATABASE_PATH=data/bot.sqlite
# (선택) 커맨드 로그 폴더. 서버별로 <서버 ID>.log 파일이 생긴다. 기본값: logs
LOG_DIR=logs
# (선택) 로그 날짜의 시간대. 기본값: Asia/Seoul
LOG_TIMEZONE=Asia/Seoul
# (선택) 판별 결과 캡쳐 저장 폴더. 서버별 하위 폴더가 생긴다. 기본값: data/records
RECORDS_DIR=data/records
# (선택) /관리자 데이터적재 이미지 자동 인식 방식
#   paligemma : 무료. PC에서 scripts/paligemma/server.py 를 함께 실행 (K/D/A · CS만 인식, 챔피언/승리팀은 직접 입력)
#   claude    : 유료. ANTHROPIC_API_KEY 필요 (챔피언 · K/D/A · CS · 승리팀까지 인식)
#   비우면    : ANTHROPIC_API_KEY가 있으면 claude, 없으면 꺼짐(직접 입력)
SCOREBOARD_PROVIDER=
# PaliGemma 서버 주소와 이미지 조각 수(가로 x 세로), 시간 제한(초)
PALIGEMMA_URL=http://127.0.0.1:8765
PALIGEMMA_TILES_X=2
PALIGEMMA_TILES_Y=5
PALIGEMMA_TIMEOUT_SEC=600
# Claude API 키 (SCOREBOARD_PROVIDER=claude 일 때)
ANTHROPIC_API_KEY=
SCOREBOARD_MODEL=claude-opus-5-5
